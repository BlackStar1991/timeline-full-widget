{
	"name": "timeline-full-widget",
	"version": "4.1.0",
	"description": "A versatile Timeline plugin for Elementor and Gutenberg WordPress themes — add beautiful Timelines anywhere!",
	"license": "GPL-2.0-or-later",
	"author": "BlackStar1991",
	"homepage": "https://github.com/BlackStar1991/timeline-full-widget#readme",
	"bugs": {
		"url": "https://github.com/BlackStar1991/timeline-full-widget/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BlackStar1991/timeline-full-widget.git"
	},
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"fix:js": "wp-scripts lint-js --fix",
		"fix:css": "wp-scripts lint-style --fix",
		"test:js": "node scripts/tests/js-runtime.mjs",
		"test:php": "php scripts/tests/php-runtime.php",
		"test:release": "php scripts/check-release.php",
		"test:psr4": "php scripts/check-psr4.php",
		"test": "npm run test:js && npm run test:animation && npm run test:transfer && npm run test:ui && npm run test:php && npm run test:release && npm run test:blueprint && npm run test:psr4 && npm run test:editor-ui && npm run test:align && npm run test:cleanup",
		"check": "npm run lint:js && npm run lint:css",
		"fix": "npm run fix:js && npm run fix:css",
		"test:transfer": "node scripts/tests/transfer.mjs",
		"test:blueprint": "php scripts/check-blueprint.php",
		"test:ui": "node scripts/tests/transfer-ui.mjs",
		"test:animation": "node scripts/tests/animation-scroll.mjs",
		"test:editor-ui": "node scripts/tests/editor-media-color.mjs && node scripts/tests/elementor-media-controls.mjs && node scripts/tests/gutenberg-media-settings.mjs",
		"test:align": "node scripts/tests/alignment-width.mjs",
		"test:cleanup": "node scripts/tests/refactor-no-legacy.mjs"
	},
	"devDependencies": {
		"@wordpress/blob": "^4.57.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/prettier-config": "^4.57.0",
		"@wordpress/scripts": "^36.1.0",
		"@wordpress/stylelint-config": "^26.1.0",
		"prettier": "npm:wp-prettier@^3.9.6",
		"stylelint": "^17.16.0",
		"stylelint-scss": "^7.3.0"
	}
}
