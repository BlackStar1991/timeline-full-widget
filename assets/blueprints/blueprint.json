ide text</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:za/timeline-item-side -->\n\n<!-- wp:za/timeline-item-content {\"showMedia\":false} -->\n<div class=\"wp-block-za-timeline-item-content timeline-panel\"><div class=\"tl-content\"><div class=\"tl-desc\"><div class=\"tl-desc-short\"><!-- wp:heading {\"level\":3,\"className\":\"tl-title\"} -->\n<h3 class=\"wp-block-heading tl-title\">Timeline Item #2</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Timeline item content example.</p>\n<!-- /wp:paragraph --></div></div></div></div>\n<!-- /wp:za/timeline-item-content --></li>\n<!-- /wp:za/timeline-item --></ul></div></div>\n<!-- /wp:za/timeline-full-widget -->\nHTML;\n\nwp_update_post(\n\tarray(\n\t\t'ID'           => $page_id,\n\t\t'post_title'   => 'Timeline Demo',\n\t\t'post_name'    => 'timeline-demo',\n\t\t'post_status'  => 'publish',\n\t\t'post_content' => $content,\n\t)\n);\n\nupdate_option( 'show_on_front', 'page' );\nupdate_option( 'page_on_front', $page_id );\n"
